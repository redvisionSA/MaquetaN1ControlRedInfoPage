# Variables de la tienda de Control Red. Las de servidor (sin VITE_) se cargan
# en Cloudflare Pages: proyecto controlred-web > Settings > Variables and secrets.
# Las VITE_ las lee el navegador y se incrustan en el build: para publicar NO
# debe existir .env.local (Vite lo incrustaria). Este archivo es solo
# documentacion y no debe contener valores reales.

# ---------------------------------------------------------------------------
# Catalogo (contrato: docs/CATALOGO_API.md)

# Endpoint publico del ERP con el catalogo de Control Red. Sin la variable, en
# produccion se usa https://api-erp.redvision.com.ar/storefront/controlred/catalog
# y en desarrollo el catalogo de demostracion (src/tienda/demo.js).
# Para desarrollar con datos reales (el CORS del ERP no acepta localhost:5190),
# en .env.development.local (solo lo lee npm run dev, nunca el build):
# VITE_CATALOGO_URL=/erp/storefront/controlred/catalog (proxy de vite.config.js).
VITE_CATALOGO_URL=

# Opcional. El mismo endpoint, leido por api/pedido.js y functions/api/evento.js
# en el servidor. Si falta, VITE_CATALOGO_URL y despues el de produccion.
CATALOGO_URL=

# ---------------------------------------------------------------------------
# Cuentas de clientes (Gremio, Mayorista, Distribuidor): /cuenta/*
# Base de la tienda en el ERP, sin barra final. Sin la variable se usa
# https://api-erp.redvision.com.ar/shop/controlred (en desarrollo, con el proxy:
# VITE_CUENTAS_URL=/erp/shop/controlred).
VITE_CUENTAS_URL=

# Opcional. La misma base, leida por api/pedido.js para poner al pedido de un
# cliente con sesion los precios de su lista.
CUENTAS_URL=

# ---------------------------------------------------------------------------
# Pedidos por correo (api/pedido.js)

# Obligatoria para recibir pedidos. API key de https://resend.com. Sin ella el
# carrito muestra un error controlado y ofrece mandar el pedido por WhatsApp.
RESEND_API_KEY=

# Opcional. Remitente. Sin la variable sale desde onboarding@resend.dev. Con un
# dominio verificado en Resend tambien se manda copia al cliente. Ojo: los
# registros DNS de Resend no deben pisar el SPF existente de controlred.com.ar.
RESEND_FROM="Control Red Web <tienda@controlred.com.ar>"

# Opcional. Casilla que recibe los pedidos (por defecto ventasgremio@controlred.com.ar).
PEDIDOS_EMAIL_DESTINO=

# ---------------------------------------------------------------------------
# Popularidad («lo más buscado y cotizado»): base D1 con binding DB
# (docs/popularidad.sql) y la sal del hash de visitantes.
POPULARIDAD_SAL=
